{
  "name": "cinyuverse",
  "private": true,
  "version": "0.1.0",
  "description": "CinyuVerse - AI 小说创作 IDE",
  "author": "LingByte",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "compile:electron": "node --experimental-strip-types electron/build.ts",
    "dev:electron": "npm run compile:electron && concurrently -k \"vite\" \"node --experimental-strip-types electron/watch.ts\" \"wait-on http://127.0.0.1:9090 && node dist-electron/run.js\"",
    "build": "vue-tsc -b && vite build",
    "build:electron": "npm run build && npm run compile:electron",
    "preview": "vite preview",
    "dist": "npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.3",
    "@fontsource-variable/geist": "^5.2.8",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "2.30.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.8.0",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.0",
    "motion": "^12.38.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.32",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vue-tsc": "^3.2.6",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "date-fns": "2.30.0"
  },
  "build": {
    "appId": "com.lingbyte.cinyuverse",
    "productName": "CinyuVerse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  }
}
