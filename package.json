    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.294.0",
    "marked": "^15.0.12",
    "monaco-editor": "^0.54.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "pinia": "^2.1.7",
    "radix-vue": "^1.9.17",
