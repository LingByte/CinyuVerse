[Unit]
Description=Cinyuverse headless Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cinyuverse
Group=cinyuverse
Environment=CINYUVERSE_DATA_DIR=/var/lib/cinyuverse
Environment=CINYUVERSE_STATIC_ROOT=/usr/lib/cinyuverse/web
Environment=CINYUVERSE_SERVER_LISTEN=127.0.0.1:17891
ExecStart=/usr/bin/cinyuverse-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cinyuverse
PrivateTmp=true

[Install]
WantedBy=multi-user.target
