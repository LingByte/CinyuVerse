# CinyuVerse AI 配置（复制为 .env 放在仓库根目录或 src-tauri/）

# Ollama 本地模型
AI_PROVIDER=Ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen2.5
AI_API_KEY=ollama

# OpenAI 兼容 API（如通义、DeepSeek 等）
# AI_PROVIDER=OpenAI
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=your-api-key-here
# AI_MODEL=qwen-turbo

# 应用设置
APP_NAME=CinyuVerse
APP_VERSION=0.1.0
APP_DEBUG=true
APP_LOG_LEVEL=info
