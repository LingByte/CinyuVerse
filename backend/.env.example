# ═══════════════════════════════════════════════════════════════
# CinyuVerse Go Story 后端环境变量
# 复制为 backend/.env 或在启动前 export
# ═══════════════════════════════════════════════════════════════

# ── LLM（必填）────────────────────────────────────────────────
# provider: ollama | openai | custom
STORY_LLM_PROVIDER=ollama
STORY_LLM_MODEL=gemma4:31b-cloud

# Ollama 本地默认 http://127.0.0.1:11434；OpenAI 兼容网关填完整 base URL
STORY_LLM_BASE_URL=http://127.0.0.1:11434

# openai / custom 提供商时必填；本地 Ollama 通常留空
# STORY_LLM_API_KEY=sk-...

# 单次生成最大 token（可选，默认 8192）
# STORY_LLM_MAX_TOKENS=8192

# ── HTTP 服务 ─────────────────────────────────────────────────
STORY_HTTP_ADDR=:4567
STORY_PROJECT_ROOT=.

# ── 前端对接（在仓库根 .env，非本文件）────────────────────────
# VITE_API_BASE_URL=http://localhost:4567

# ── 朱雀 AIGC 检测（可选，project.json detection.enabled=true 时用）─
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# STORY_ZHUQUE_REGION=ap-guangzhou
# STORY_ZHUQUE_BIZ_TYPE=TencentCloudDefault

# ── 封面生成（可选）──────────────────────────────────────────
# STORY_COVER_API_KEY=
# STORY_COVER_BASE_URL=
# STORY_COVER_MODEL=
# STORY_COVER_ENDPOINT=
